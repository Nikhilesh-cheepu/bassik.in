# Copy to .env.local and fill in values.

DATABASE_URL="postgresql://..."

# Admin automations: file parsing + column mapping
OPENAI_API_KEY=

# Optional
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_DOCUMENT_MODEL=gpt-4o
# Offer poster vision (defaults to gpt-4o-mini; must support images)
# OPENAI_OFFER_VISION_MODEL=gpt-4o-mini
# If posters are not on Vercel Blob, comma-separated allowed hostnames:
# OFFER_ANALYZE_IMAGE_HOSTS=cdn.example.com

# Twilio WhatsApp (Automations → Step 4)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Sandbox example: whatsapp:+14155238886 — use your approved WhatsApp sender in production
TWILIO_WHATSAPP_FROM=

# Guest mobile OTP (MSG91) — verify at booking, not before browse
# Get auth key: MSG91 → OTP → API / Authkey
# Template: OTP → Templates → copy Template ID (DLT approved, ##OTP## variable)
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=
# Set false to skip OTP check on bookings (dev only)
# MSG91_OTP_REQUIRED=false
# Dev without MSG91: auto-mocks OTP 123456 when MSG91_AUTH_KEY is empty
# MSG91_OTP_MOCK=true
# GUEST_SESSION_SECRET=

# Interakt WhatsApp (Booking confirmations)
INTERAKT_API_KEY=
INTERAKT_BOOKING_TEMPLATE_NAME=bassik_website
INTERAKT_BOOKING_TEMPLATE_LANGUAGE_CODE=en
INTERAKT_EVENT_TEMPLATE_NAME=bassik_website_events
INTERAKT_EVENT_TEMPLATE_LANGUAGE_CODE=en
# Optional: second WhatsApp to outlet team (10-digit Indian mobile, no +91). Omit = no staff copy.
INTERAKT_STAFF_NOTIFY_PHONE=
# Table-booking outlet template (same body placeholders as INTERAKT_BOOKING_TEMPLATE_NAME). Default: bassik_website_outlet
# INTERAKT_STAFF_BOOKING_TEMPLATE_NAME=
# INTERAKT_STAFF_BOOKING_TEMPLATE_LANGUAGE_CODE=en
# Event outlet notify (same body placeholders as INTERAKT_EVENT_TEMPLATE_NAME). Default: bassik_events_outlet
# INTERAKT_STAFF_EVENT_TEMPLATE_NAME=
# INTERAKT_STAFF_EVENT_TEMPLATE_LANGUAGE_CODE=en

# Daily WhatsApp offers / follow-ups (cron trigger)
# Call POST https://yourdomain.com/api/automation/daily-offers with header:
# x-cron-secret: (same value)
DAILY_OFFERS_CRON_SECRET=

# Used for building booking links in WhatsApp replies (optional; falls back to host header)
# NEXT_PUBLIC_SITE_URL=https://bassik.in

# Optional: Firefly outlet hero background loop (MP4/WebM URL). Pauses when tab is hidden.
# NEXT_PUBLIC_FIREFLY_HERO_AMBIENT_VIDEO=https://example.com/firefly-hero.mp4

# Admin session (production: set a long random string)
# ADMIN_SESSION_SECRET=
