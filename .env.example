# Copy to .env.local and fill in values.

DATABASE_URL="postgresql://..."

# Admin automations: file parsing + column mapping
OPENAI_API_KEY=

# Optional
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_DOCUMENT_MODEL=gpt-4o

# Twilio WhatsApp (Automations → Step 4)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Sandbox example: whatsapp:+14155238886 — use your approved WhatsApp sender in production
TWILIO_WHATSAPP_FROM=

# Daily WhatsApp offers / follow-ups (cron trigger)
# Call POST https://yourdomain.com/api/automation/daily-offers with header:
# x-cron-secret: (same value)
DAILY_OFFERS_CRON_SECRET=

# Used for building booking links in WhatsApp replies (optional; falls back to host header)
# NEXT_PUBLIC_SITE_URL=https://bassik.in

# Admin session (production: set a long random string)
# ADMIN_SESSION_SECRET=
