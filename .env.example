# Copy to .env.local and fill in values.

DATABASE_URL="postgresql://..."

# Railway public proxy — required on Vercel when DATABASE_URL uses *.railway.internal
# DATABASE_PUBLIC_URL="postgresql://..."

# Pause designer auto-seed (default: frozen). Set to 0 when re-seeding is OK again.
# TEAM_DESIGNER_QUEUE_FROZEN=0

# Admin automations: file parsing + column mapping
OPENAI_API_KEY=

# Optional
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_DOCUMENT_MODEL=gpt-4o
# Offer poster vision (defaults to gpt-4o-mini; must support images)
# OPENAI_OFFER_VISION_MODEL=gpt-4o-mini
# If posters are not on Vercel Blob, comma-separated allowed hostnames:
# OFFER_ANALYZE_IMAGE_HOSTS=cdn.example.com

# Twilio WhatsApp (Automations → Step 4)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Sandbox example: whatsapp:+14155238886 — use your approved WhatsApp sender in production
TWILIO_WHATSAPP_FROM=

# Guest mobile OTP (MSG91) — OFF by default until DLT + MSG91 are live
# Get auth key: MSG91 → OTP → API / Authkey
# Template: OTP → Templates → copy Template ID (DLT approved, ##OTP## variable)
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=
# Enable OTP on bookings only when SMS works (both server + client flags):
# MSG91_OTP_REQUIRED=true
# NEXT_PUBLIC_MSG91_OTP_REQUIRED=true
# Dev without MSG91: auto-mocks OTP 123456 when MSG91_AUTH_KEY is empty
# MSG91_OTP_MOCK=true
# GUEST_SESSION_SECRET=

# Interakt WhatsApp (Booking confirmations)
INTERAKT_API_KEY=
INTERAKT_BOOKING_TEMPLATE_NAME=bassik_website
INTERAKT_BOOKING_TEMPLATE_LANGUAGE_CODE=en
INTERAKT_EVENT_TEMPLATE_NAME=bassik_website_events
INTERAKT_EVENT_TEMPLATE_LANGUAGE_CODE=en
# Optional: second WhatsApp to outlet team (10-digit Indian mobile, no +91). Omit = no staff copy.
INTERAKT_STAFF_NOTIFY_PHONE=
# Table-booking outlet template (same body placeholders as INTERAKT_BOOKING_TEMPLATE_NAME). Default: bassik_website_outlet
# INTERAKT_STAFF_BOOKING_TEMPLATE_NAME=
# INTERAKT_STAFF_BOOKING_TEMPLATE_LANGUAGE_CODE=en
# Event outlet notify (same body placeholders as INTERAKT_EVENT_TEMPLATE_NAME). Default: bassik_events_outlet
# INTERAKT_STAFF_EVENT_TEMPLATE_NAME=
# INTERAKT_STAFF_EVENT_TEMPLATE_LANGUAGE_CODE=en

# Daily WhatsApp offers / follow-ups (cron trigger)
# Call POST https://yourdomain.com/api/automation/daily-offers with header:
# x-cron-secret: (same value)
DAILY_OFFERS_CRON_SECRET=

# Used for building booking links in WhatsApp replies (optional; falls back to host header)
# NEXT_PUBLIC_SITE_URL=https://bassik.in

# Razorpay — Club Rogue table booking (₹50 confirmation fee)
# Dashboard → Settings → API Keys → Live mode
RAZORPAY_KEY_ID=rzp_live_
RAZORPAY_KEY_SECRET=
# Optional: same as RAZORPAY_KEY_ID if something client-side needs it (checkout gets key from API)
# NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_
# Fee in paise — 5000 = ₹50 confirmation fee
CLUB_ROGUE_RESERVATION_FEE_PAISE=5000
# Razorpay webhook secret (Dashboard → Webhooks → create → copy secret)
RAZORPAY_WEBHOOK_SECRET=
# Local dev only — skip Razorpay and confirm bookings free (never set on production)
# CLUB_ROGUE_ALLOW_BOOK_WITHOUT_PAYMENT=true

# External outlet sites that may iframe chat (comma-separated origins, no trailing slash)
# Example: https://fireflyclub.in,https://www.fireflyclub.in
# CHAT_EMBED_ALLOWED_ORIGINS=

# Optional: Firefly outlet hero background loop (MP4/WebM URL). Pauses when tab is hidden.
# NEXT_PUBLIC_FIREFLY_HERO_AMBIENT_VIDEO=https://example.com/firefly-hero.mp4

# Admin session (production: set a long random string)
# ADMIN_SESSION_SECRET=

# Team ads board (/team) — member passwords are in lib/team-members.ts and lib/team-auth.ts
# Optional: override roster via TEAM_MEMBERS_JSON
# TEAM_MEMBERS_JSON='[{"id":"amit","name":"Amit","role":"Posting + Ads + GBP"},{"id":"mahesh","name":"Mahesh","role":"Designer & Editor"},{"id":"jeslyn","name":"Jeslyn","role":"Designer"},{"id":"srinath","name":"Srinath","role":"Shoots","kind":"content"}]'
# TEAM_SESSION_SECRET=
# 10-digit Indian mobile for team WhatsApp reports (optional; omit = pick contact in WA)
# TEAM_WHATSAPP_PHONE=7013884485
# Optional dedicated secret for /api/cron/team-handoff-blobs (else DAILY_OFFERS_CRON_SECRET)
# TEAM_HANDOFF_CRON_SECRET=

# Meta WhatsApp Cloud API — designer daily-target nudges (not Interakt)
# Until Cloud API is live, /team Design shows click-to-Send WA share links.
# WHATSAPP_CLOUD_TOKEN=
# WHATSAPP_CLOUD_PHONE_NUMBER_ID=
# TEAM_DESIGNER_WA_PHONES={"mahesh":"91xxxxxxxxxx","jeslyn":"91xxxxxxxxxx","amit":"91xxxxxxxxxx"}
# Optional approved utility template (body vars: name, summary, job list)
# TEAM_WA_TEMPLATE_DESIGNER_NUDGE=designer_daily_nudge
# TEAM_WA_TEMPLATE_LANGUAGE=en
# Optional cron secret override for /api/cron/designer-nudges
# DESIGNER_NUDGE_CRON_SECRET=
# Phones still help prefill the share link even without Cloud API token.

# Public site mode — unset/false = agency landing (default). true = old venue booking homepage.
# VENUE_BOOKING_LIVE=false
# NEXT_PUBLIC_VENUE_BOOKING_LIVE=false
# HQ WhatsApp for agency CTAs (10-digit India mobile)
# BASSIK_HQ_PHONE=7013884485
# NEXT_PUBLIC_BASSIK_HQ_PHONE=7013884485
# Canonical URL for SEO (sitemap / Open Graph)
# NEXT_PUBLIC_SITE_URL=https://bassik.in
