# Environment Variables Configuration
# Copy this file to .env and update values

# Backend API URL
# For local development, use your computer's local IP address
# For production, use your deployed website URL
EXPO_PUBLIC_API_URL=https://bassik.in

# Examples:
# Local development: EXPO_PUBLIC_API_URL=http://192.168.1.10:3000
# ngrok tunnel: EXPO_PUBLIC_API_URL=https://abc123.ngrok.io
# Production: EXPO_PUBLIC_API_URL=https://bassik.in
